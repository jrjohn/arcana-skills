<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for ~/Library/LaunchAgents/com.<USERNAME>.claude-archive.plist
  Written by scripts/install-launchd-schedule.sh (called from install.sh).

  This plist deliberately carries NO credentials and NO environment.
  It runs ~/claude-archive/bin/crs-build-launcher, which reads
  ~/.config/crs/env.sh — the one place CRS_PG_* live — and adds the overlap
  guard and the hang watchdog.

  Why: the previous template embedded a placeholder host and password in
  EnvironmentVariables and asked for a hand edit. (The literal placeholder
  strings are deliberately not repeated here: grepping a live plist for them is
  how a reverted install gets spotted, and a copy in this comment would make
  that check fire on every correct install.)
  Any later install.sh run that regenerated the plist put the placeholders
  back. On 2026-07-23 that happened to a working install; ingest carried on
  through the pgsearchd daemon (which reads env.sh), so it went unnoticed for
  two months while every directly-connecting feature failed on every tick.
  With nothing secret in this file, regenerating it is always safe.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.<USERNAME>.claude-archive</string>
  <key>ProgramArguments</key>
  <array>
    <string><HOME>/claude-archive/bin/crs-build-launcher</string>
  </array>
  <key>StartInterval</key><integer>900</integer>     <!-- every 15 minutes -->
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string><HOME>/claude-archive/build.log</string>
  <key>StandardErrorPath</key><string><HOME>/claude-archive/build.err</string>
</dict>
</plist>
